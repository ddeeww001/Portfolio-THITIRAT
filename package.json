{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:xss": "vitest run tests/security/xss.test.ts",
    "test:security": "vitest run tests/security tests/shared/securityGuards.test.ts tests/config/envPrivacy.test.ts",
    "test:app": "vitest run tests/app",
    "test:features": "vitest run tests/features",
    "test:shared": "vitest run tests/shared",
    "test:config": "vitest run tests/config",
    "test:frontend": "vitest run tests/app tests/features",
    "test:backend": "vitest run tests/config tests/shared tests/security",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"

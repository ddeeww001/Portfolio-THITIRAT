# Private profile data only.
# Public data (name, email, GitHub, Line, Instagram, Facebook) is NOT here — edit src/config/profile.ts.
# Phone number: shown only as a "Call" icon; leave empty to hide it. On Vercel, set it in
# Project → Settings → Environment Variables and redeploy.
VITE_USER_PHONE="000-000-0000"

# 🔒 Security System Configurations (Production & Actual Use)
PORT=3000
# Do NOT put NODE_ENV here: Vite reads .env and would turn `vite build` into a
# development build (React dev mode + dev-only logs in production).
# Set it for the backend when starting it instead, e.g. `NODE_ENV=production node server.js`.
JWT_SECRET="your-super-strong-jwt-secret-at-least-32-characters-long!"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"
# "strict" | "standard" (any other value falls back to "strict"). Not yet used by the app.
VITE_SECURITY_MODE="strict"
# "true" | "false" — shows the Self-XSS warning in the browser console.
VITE_ENABLE_SELF_XSS_WARNING="true"
# "true" | "false" — reserved for future security logging. Not yet used by the app.
VITE_ENABLE_SECURITY_LOGS="true"

# 🧪 Security Test Suite Configurations (Testing Environment)
TEST_SECURITY_SECRET="your-test-secret-key-for-running-security-tests-32chars"
TEST_XSS_TIMEOUT=5000
# "true" | "false" — reserved for a future CSP enforcement test mode. Not yet used by the app.
VITE_TEST_CSP_ENFORCE="true"
